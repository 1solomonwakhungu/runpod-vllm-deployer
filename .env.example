# Copy to .env, replace placeholders, and never commit the resulting file.
RUNPOD_API_KEY=replace_with_your_runpod_api_key

# Optional for gated Hugging Face models.
HF_TOKEN=replace_with_your_hugging_face_token

# Optional only when the vLLM endpoint itself requires a bearer token.
VLLM_API_KEY=replace_with_your_endpoint_bearer_token
